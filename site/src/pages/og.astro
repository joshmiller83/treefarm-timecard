---
/**
 * Hidden 1200 × 630 template for the Open Graph image. `npm run og` screenshots it into
 * public/og.png (committed, so the build never depends on it). noindex; not in the sitemap.
 */
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { liveActivityAt, MOMENTS, fmtPct } from '../data/ledger';

const la = liveActivityAt(MOMENTS.lockScreen);
const bands = [
  { y: 548, size: 40, color: '#173229', opacity: 0.6, step: 34 },
  { y: 584, size: 64, color: '#10261B', opacity: 1, step: 52 },
  { y: 640, size: 104, color: '#0A1C13', opacity: 1, step: 76 },
];
---

<Base title="Time Card: Keep your gloves on." noindex noMotion>
  <div class="og" data-og>
    <div class="sky"></div>
    <svg class="bands" viewBox="0 0 1200 630" aria-hidden="true">
      {
        bands.map((b, i) => (
          <g fill={b.color} opacity={b.opacity}>
            {Array.from({ length: Math.ceil(1260 / b.step) }, (_, k) => {
              const jitter = ((k * 37 + i * 11) % 9) - 4;
              const s = b.size * (0.82 + (((k * 53 + i * 7) % 7) / 7) * 0.36);
              return <use href="#fir" x={k * b.step - 40 + jitter} y={b.y - s + 24} width={s * 0.83} height={s} />;
            })}
            <rect x="0" y={b.y + 20} width="1200" height="200" />
          </g>
        ))
      }
    </svg>

    <div class="copy">
      <div class="brand">
        <AppIcon size="64px" />
        <span class="name">Time Card</span>
      </div>
      <p class="eyebrow">For Christmas tree trimmers</p>
      <h1 class="headline">Keep your gloves on.</h1>
      <p class="sub">Clock in, mark rows and take lunch by voice or from the lock screen.</p>
      <p class="status"><span class="dot"></span>In development · TestFlight beta coming · Open source</p>
    </div>

    <div class="device">
      <div class="glow"></div>
      <div class="la">
        <div class="row1">
          <span class="pill">{la.pill}</span>
          <span class="place">{la.field} · {la.block}</span>
        </div>
        <div class="timer">{la.worked}</div>
        <div class="row3">
          <span><b>{la.trees}</b> trees this shift</span>
          <span class="bar"><i style={`transform:scaleX(${la.fieldPct})`}></i></span>
          <span class="pct">{fmtPct(la.fieldPct)}</span>
        </div>
        <div class="btns">
          {la.rows.map((r) => <span class="btn-row">Row {r}</span>)}
          <span class="btn-break">Break</span>
        </div>
      </div>
      <p class="caption">The lock-screen Live Activity. One tap marks a whole row.</p>
    </div>
  </div>
</Base>

<style>
  :global(html),
  :global(body) {
    background: #08140d;
  }
  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    color: var(--on-stage);
    background: #0a1620;
  }
  .sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 40% at 74% 100%, rgba(226, 166, 68, 0.22), transparent 100%),
      linear-gradient(180deg, #0a1620 0%, #12261c 100%);
  }
  .bands {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .copy {
    position: absolute;
    left: 72px;
    top: 64px;
    width: 560px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .brand :global(.app-icon) {
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
  }
  .eyebrow {
    font-size: 15px;
    margin-bottom: 14px;
  }
  .headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 100px;
    line-height: 0.92;
    letter-spacing: -0.025em;
    max-width: 7.5ch;
  }
  .sub {
    margin-top: 22px;
    max-width: 30ch;
    font-size: 21px;
    line-height: 1.45;
    color: var(--on-stage-muted);
  }
  .status {
    position: absolute;
    left: 72px;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--sap-soft);
    color: var(--sap-ink);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 15px;
  }
  .copy .status {
    position: static;
    display: inline-flex;
    margin-top: 28px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  .device {
    position: absolute;
    right: 64px;
    top: 168px;
    width: 470px;
    --pt: 1.3px;
  }
  .glow {
    position: absolute;
    inset: -60px -40px;
    background: radial-gradient(closest-side, rgba(46, 122, 78, 0.45), transparent);
  }
  .la {
    position: relative;
    padding: calc(12 * var(--pt)) calc(14 * var(--pt)) calc(14 * var(--pt));
    border-radius: calc(24 * var(--pt));
    background: rgba(16, 30, 22, 0.94);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.55),
      inset 0 0 0 1px rgba(136, 207, 164, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    font-family: var(--font-body);
  }
  .row1,
  .row3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .pill {
    height: calc(22 * var(--pt));
    padding: 0 calc(9 * var(--pt));
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: #2e7a4e;
    color: #fff;
    font-weight: 600;
    font-size: calc(13 * var(--pt));
  }
  .place {
    font-size: calc(13 * var(--pt));
    color: rgba(242, 245, 239, 0.72);
  }
  .timer {
    margin: calc(4 * var(--pt)) 0 calc(2 * var(--pt));
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: calc(38 * var(--pt));
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .row3 {
    font-size: calc(14 * var(--pt));
    color: rgba(242, 245, 239, 0.86);
  }
  .row3 b {
    font-family: var(--font-mono);
    font-weight: 600;
    color: #fff;
  }
  .bar {
    flex: 1;
    height: calc(4 * var(--pt));
    border-radius: 999px;
    background: #1c3125;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--gold-lit);
    transform-origin: left;
  }
  .pct {
    font-family: var(--font-mono);
    font-size: calc(12 * var(--pt));
    color: rgba(242, 245, 239, 0.72);
  }
  .btns {
    display: flex;
    gap: calc(8 * var(--pt));
    margin-top: calc(12 * var(--pt));
  }
  .btn-row,
  .btn-break {
    flex: 1;
    height: calc(46 * var(--pt));
    display: grid;
    place-items: center;
    border-radius: calc(14 * var(--pt));
    font-weight: 600;
    font-size: calc(16 * var(--pt));
  }
  .btn-row {
    background: #1d5b3a;
    color: #fff;
  }
  .btn-break {
    box-shadow: inset 0 0 0 calc(1.5 * var(--pt)) rgba(242, 245, 239, 0.5);
  }
  .caption {
    position: relative;
    margin-top: 22px;
    font-size: 16px;
    color: var(--on-stage-muted);
    text-align: center;
  }
</style>
