---
/**
 * PACE · 3:40 PM · the Clock tab (section team: pace).
 *
 *   beat 0  eyebrow, "Know your pace." and the body                      (SectionShell)
 *   beat 1  three stat tiles: 34 trees an hour · 1:46 a tree · 179 hours left
 *   beat 2  three bullets and the small print about hidden pay
 *   figure  the phone: the Clock tab at 3:40 PM (final), under the lock screen at 3:40 with
 *           the Live Activity; without motion a second phone shows the tab scrolled down
 *
 * Every number and string comes from ./pace/pace.ts (which reads the ledger and the
 * screens team's clock model). Scene: src/scripts/scenes/pace.ts. Spec:
 *   jq '.sections[] | select(.id=="pace")' docs/landing/brief.json
 */
import SectionShell from '../components/SectionShell.astro';
import Phone from '../components/phone/Phone.astro';
import Screen from '../components/phone/Screen.astro';
import LockScreen from '../components/phone/LockScreen.astro';
import LiveActivity from '../components/phone/LiveActivity.astro';
import ClockTab from '../components/app/ClockTab.astro';
import Icon from '../components/app/Icon.astro';
import { fmtClock } from '../data/ledger';
import { AT, COPY, PACE_AT, bottomCropLabel, phoneLabel, rollHTML, tilesAt } from './pace/pace';

const label = phoneLabel();
const tiles = tilesAt();
---

<SectionShell id="pace">
  <Fragment slot="intro">
    <p>{COPY.body}</p>
  </Fragment>

  <div class="beat pace-stats" data-beat="1" style={`--at:${AT.stats};--at-mob:${AT.statsMob}`}>
    <ul class="pace-tiles" data-pace-tiles>
      {
        tiles.map((t) => (
          <li class="pace-tile" data-tile={t.id} data-row={t.row}>
            <span class="pace-tile-line" data-tile-line aria-hidden="true" />
            <span class="pace-tile-rule" data-tile-rule aria-hidden="true" />
            <span class="pace-tile-face" aria-hidden="true">
              <span class="pace-num">
                <span class="pace-num-text">{t.text}</span>
                <span class="pace-roll" data-roll data-roll-text={t.text} set:html={rollHTML(t.text)} />
              </span>
              <span class="pace-unit">{t.unit}</span>
            </span>
            <span class="sr-only">{t.spoken}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="beat pace-more" data-beat="2" style={`--at:${AT.bullets}`}>
    <ul class="pace-bullets">
      {
        COPY.bullets.map((b, i) => (
          <li data-bullet={i}>{b.before}<strong>{b.em}</strong>{b.after}</li>
        ))
      }
    </ul>
    <p class="pace-small" data-small>
      <Icon name="eye.slash" size="1.25em" weight={2} class="pace-small-icon" />
      <span>{COPY.small}</span>
    </p>
  </div>

  <figure class="shot pace-shot" data-stage-shot slot="figure">
    <div class="pace-crops">
      <Phone label={label} class="pace-phone">
        <div class="screens" data-screens>
          <Screen stateId="clock-1540" alt={label} tone="light" final>
            <ClockTab at={PACE_AT} />
          </Screen>
          <Screen stateId="lock-1540-activity" alt={label} tone="dark">
            <LockScreen time={fmtClock(PACE_AT)}>
              <LiveActivity at={PACE_AT} />
            </LockScreen>
          </Screen>
        </div>
      </Phone>
      <Phone label={bottomCropLabel()} class="pace-phone pace-phone--bottom static-only">
        <div class="screens pace-crop-bottom">
          <Screen stateId="clock-1540-bottom" alt={bottomCropLabel()} tone="light" final>
            <ClockTab at={PACE_AT} live={false} />
          </Screen>
        </div>
      </Phone>
    </div>
    <figcaption>{COPY.caption}</figcaption>
  </figure>
</SectionShell>

<style is:global>
  /* In-phone touches, keyed to this chapter's layers (they move into the stage phone). */
  [data-screen='clock-1540'] {
    /* Rounded like the screen, so the tab reads as a card while it scales in on unlock. */
    border-radius: calc(55 * var(--pt));
    overflow: hidden;
  }
  /* The shared touch ring is white (made for the dark lock screen); on the light app it is ink. */
  [data-screen='clock-1540'] .tap-ring {
    background: rgba(29, 91, 58, 0.55);
  }
</style>

<style>
  /* ---------- Stat tiles: one big number each, the unit under it ---------- */
  .pace-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .pace-tile {
    position: relative;
    padding: 18px 0 20px;
  }
  .pace-tile:first-child {
    padding-top: 0;
  }
  /* The 1px rule between tiles (its own element, so it can draw in with its tile). */
  .pace-tile-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--stage-line);
    transform-origin: 0 50%;
  }
  .pace-tile:first-child .pace-tile-line {
    display: none;
  }
  .pace-tile-face {
    display: block;
  }
  .pace-num {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-stat);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--on-stage);
  }
  .pace-unit {
    display: block;
    margin-top: 6px;
    max-width: 26ch;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--on-stage-muted);
    text-wrap: balance;
  }
  /* The gold rule: the same 3 pt rule the phone draws beside the matching pace row. */
  .pace-tile-rule {
    position: absolute;
    left: -22px;
    top: calc(var(--text-stat) * 0.17);
    width: 3px;
    height: calc(var(--text-stat) * 0.76);
    border-radius: 3px;
    background: var(--gold-lit);
    transform-origin: 50% 50%;
  }
  .pace-tile + .pace-tile .pace-tile-rule {
    top: calc(18px + var(--text-stat) * 0.17);
  }

  /* Rolling digits (motion only; the plain number is the static page and the fallback). */
  .pace-roll {
    display: none;
  }
  :global(html.motion) .pace-roll {
    display: inline-flex;
    align-items: flex-start;
  }
  :global(html.motion) .pace-num-text {
    display: none;
  }
  .pace-roll :global(.roll-d) {
    display: inline-block;
    height: 1.08em;
    overflow: hidden;
    /* A drum, not a window: digits fade at the clip's edges while they roll. */
    -webkit-mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(transparent, #000 12%, #000 88%, transparent);
  }
  .pace-roll :global(.roll-col) {
    display: flex;
    flex-direction: column;
  }
  .pace-roll :global(.roll-col > span),
  .pace-roll :global(.roll-s) {
    display: block;
    height: 1.08em;
    line-height: 1.08em;
    text-align: center;
  }
  .pace-roll :global(.roll-s) {
    display: inline-block;
  }

  /* ---------- Bullets and the small print ---------- */
  .pace-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    max-width: 38ch;
    color: var(--on-stage-muted);
  }
  .pace-bullets li {
    position: relative;
    padding-left: 22px;
  }
  .pace-bullets li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fir-lit);
  }
  .pace-bullets strong {
    font-weight: 600;
    color: var(--on-stage);
  }
  .pace-small {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 40ch;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--stage-line);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--on-stage-muted);
  }
  .pace-small :global(.pace-small-icon) {
    flex: none;
    margin-top: 0.05em;
    color: var(--gold-lit);
  }

  /* ---------- The figure ---------- */
  .pace-crops {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
  /* The static page's second crop: the same tab, scrolled to its end so Hours & pay sits
     above the tab bar (anchored to the layer's bottom, so it holds at any phone size). */
  .pace-crop-bottom :global([data-scroll-layer]) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-64 * var(--pt));
  }

  /* ---------- Static page (no motion, reduced motion, no JS) ---------- */
  :global(html:not(.motion)) .pace-crops {
    --phone-h: min(62svh, 560px);
  }
  :global(html:not(.motion)) .pace-crops > :global(.pace-phone--bottom) {
    margin-top: 56px;
  }

  /* ---------- Below 900px: compact tiles in a row, in a card ---------- */
  @media (max-width: 899.98px) {
    .pace-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 16px;
      row-gap: 16px;
    }
    .pace-tile,
    .pace-tile:first-child {
      padding: 2px 0 0 14px;
    }
    .pace-tile-line {
      display: none;
    }
    .pace-num {
      font-size: 2rem;
      letter-spacing: -0.02em;
    }
    .pace-unit {
      margin-top: 4px;
      font-size: 0.75rem;
      line-height: 1.3;
    }
    .pace-tile-rule,
    .pace-tile + .pace-tile .pace-tile-rule {
      left: 0;
      top: calc(2px + 2rem * 0.17);
      height: calc(2rem * 0.76);
    }
    .pace-bullets {
      gap: 12px;
    }
    .pace-small {
      margin-top: 18px;
      padding-top: 14px;
    }

    /* Without motion the tiles get the card the motion page gives every beat. */
    :global(html:not(.motion)) .pace-stats {
      background: var(--card-dark);
      border: 1px solid var(--stage-line);
      border-radius: var(--radius-card);
      padding: 20px;
    }
    :global(html:not(.motion)) .pace-crops {
      --phone-h: min(calc((100vw - 2 * var(--gutter) - 14px) / 2 * 879 / 420), 460px);
      gap: 14px;
    }
    :global(html:not(.motion)) .pace-crops > :global(.pace-phone--bottom) {
      margin-top: 36px;
    }
    /* The mobile card sits a little earlier so all three tiles reveal inside the viewport. */
    :global(html.motion) .pace-stats {
      --at: var(--at-mob) !important;
    }
  }
  @media (max-width: 599.98px) {
    /* 375px: two tiles, then the long one across the card. */
    .pace-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pace-tile[data-tile='left'] {
      grid-column: 1 / -1;
    }
    .pace-tile[data-tile='left'] .pace-unit {
      max-width: none;
    }
  }
</style>
