---
/**
 * Small inline glyphs for the voice transcript (custom, never SF Symbols):
 *   airpods  an earbud, 16px, beside 'You' (you're talking through AirPods)
 *   wave     Siri's five gold bars, beside 'Siri' (each bar is [data-bar] for the scene)
 *   check    for 'Nothing changed.'
 */
interface Props {
  name: 'airpods' | 'wave' | 'check';
  class?: string;
}
const { name, class: cls } = Astro.props;
/** Bar heights of the wave glyph (of 16), centered. */
const BARS = [6, 11, 15, 10, 7];
---

{
  name === 'airpods' && (
    <svg class:list={['g g-airpods', cls]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path
        d="M6.1 1.2c2.5 0 4.3 1.8 4.3 4.1 0 1.6-.8 2.7-2 3.3v5.2c0 .9-.6 1.4-1.3 1.4s-1.3-.5-1.3-1.4V9.6C3.6 9.4 1.8 7.6 1.8 5.3c0-2.3 1.8-4.1 4.3-4.1z"
        fill="currentColor"
      />
      <circle cx="6.1" cy="5.2" r="1.35" fill="#0b1a14" fill-opacity=".55" />
      <path d="M12.4 3.6c.9.6 1.5 1.6 1.5 2.8s-.6 2.2-1.5 2.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity=".6" />
    </svg>
  )
}
{
  name === 'wave' && (
    <svg class:list={['g g-wave', cls]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      {BARS.map((h, i) => (
        <rect data-bar={i} x={0.9 + i * 3} y={8 - h / 2} width="2.2" height={h} rx="1.1" fill="currentColor" />
      ))}
    </svg>
  )
}
{
  name === 'check' && (
    <svg class:list={['g g-check', cls]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4" />
      <path d="M4.9 8.2l2.1 2.1 4.1-4.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}

<style>
  .g {
    flex: none;
    width: 16px;
    height: 16px;
    display: inline-block;
    vertical-align: -3px;
  }
  .g-wave rect {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
</style>
