---
/**
 * THE FIELD · 2:15 PM. The awe beat: 8,540 trees as dots, then what the map means and how to
 * use it, then a working copy to try.
 * Spec: jq '.sections[] | select(.id=="field")' docs/landing/brief.json (and decisions.md).
 *
 * MOTION (scene: src/scripts/scenes/field.ts, timing: ./field/plan.ts + BEATS in fieldstate.ts)
 *   A full-bleed sticky frame. The stage phone leaves, the field arrives tilted to the horizon,
 *   flattens, the counters roll, today's rows flip to gold, the camera zooms to block 2 rows
 *   28–40 for the row 37 demo (tap, fill, Undo), the season flips (notes stay), the camera pulls
 *   out and the phone comes back on the Trees tab. Three cards fade in at their beats.
 * STATIC (reduced motion, no JS): the copy, the Trees tab, the whole field with its counter strip
 *   and legend, the close-up with row numbers and the note flag, and the three points as text.
 * AFTER THE TRACK: Try it (./field/TryIt.astro).
 */
import SectionShell from '../components/SectionShell.astro';
import FieldMap from '../components/FieldMap.astro';
import Phone from '../components/phone/Phone.astro';
import Screen from '../components/phone/Screen.astro';
import TreesTab from '../components/app/TreesTab.astro';
import Icon from '../components/app/Icon.astro';
import TryIt from './field/TryIt.astro';
import { FIELD, FIELD_TREES, MOMENTS, OLD_NOTE, fmtCount, fmtTime, positionAt } from '../data/ledger';
import { FLAG_PATH, ZOOM_TARGET, zoomSummary } from '../scripts/fieldstate';
import { odometerHTML } from '../scripts/odometer';
import { COUNTS, stripText } from './field/plan';

const Z = ZOOM_TARGET;
/** The row the demo taps: the next row at 2:15 PM (37). */
const nextRow = positionAt(MOMENTS.field).row;
const counts = [
  { key: 'trees', value: COUNTS.trees, label: 'trees' },
  { key: 'shaped', value: COUNTS.shaped, label: 'shaped' },
  { key: 'today', value: COUNTS.today, label: 'today' },
] as const;
const phoneLabel = `Time Card’s Trees tab at ${fmtTime(MOMENTS.field)}, ${FIELD.name}, zoom L, One mode. ${zoomSummary(Z, MOMENTS.field)}`;
---

<SectionShell id="field">
  <Fragment slot="intro">
    <p>
      A farm has fields. A field has blocks, laid out in rows like the ground. This one has {FIELD.blocks} blocks of {
        FIELD.rowsPerBlock
      } rows, with {FIELD.treesPerRow} trees to a row. That’s {fmtCount(FIELD_TREES)} trees.
      <span class="fm-key"><span class="sw sw-today" aria-hidden="true"></span>Gold is what you shaped this shift.</span>{' '}
      <span class="fm-key"><span class="sw sw-earlier" aria-hidden="true"></span>Green was shaped earlier.</span>{' '}
      <span class="fm-key"><span class="sw sw-ring" aria-hidden="true"></span>Rings are still to do.</span>
    </p>
  </Fragment>

  <Fragment slot="figure">
    <figure class="fm-fig fm-overview" data-field-fig>
      <div class="fm-top">
        <p class="fm-counts" data-field-counts>
          <span class="sr-only">{stripText(COUNTS)}</span>
          {
            counts.map((c, i) => (
              <Fragment>
                {i > 0 && (
                  <span class="fm-sep" aria-hidden="true">
                    ·
                  </span>
                )}
                <span class={`fm-count fm-count--${c.key}`} aria-hidden="true">
                  <span
                    class="fm-n odo"
                    data-field-count={c.key}
                    data-odo-text={fmtCount(c.value)}
                    style={`--w:${fmtCount(c.value).length}`}
                    set:html={odometerHTML(fmtCount(c.value))}
                  />
                  <span class="fm-l">{c.label}</span>
                </span>
              </Fragment>
            ))
          }
        </p>
        <span class="fm-season" aria-hidden="true" data-field-season>
          <Icon name="leaf" size="15px" />
          <span class="fm-season-clip">
            <span class="fm-season-col" data-field-season-col>
              <span>This season</span>
              <span>Next season</span>
            </span>
          </span>
        </span>
      </div>

      <div class="fm-cam" data-field-cam>
        <FieldMap class="fm-map" />
        <div class="fm-edges motion-only" aria-hidden="true" data-field-edges></div>
        <div class="fm-overlay motion-only" aria-hidden="true">
          <span class="fm-undo" data-field-undo>
            <Icon name="undo" size="16px" />
            Undo
          </span>
        </div>
      </div>

      <div class="fm-foot">
        <ul class="fm-legend" aria-label="Map key" data-field-legend>
          <li><span class="sw sw-today" aria-hidden="true"></span>Today</li>
          <li><span class="sw sw-earlier" aria-hidden="true"></span>Shaped earlier</li>
          <li><span class="sw sw-ring" aria-hidden="true"></span>Not yet</li>
          <li data-field-legend-note>
            <svg class="sw-flag" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={FLAG_PATH}></path></svg>
            Note
          </li>
        </ul>
      </div>
      <figcaption>
        {FIELD.name} at {fmtTime(MOMENTS.field)}, this season: gold for this shift, green for earlier, rings still to do.
      </figcaption>
    </figure>

    <figure class="fm-fig fm-zoomfig static-only">
      <FieldMap view="zoom" class="fm-zoommap" />
      <figcaption>
        Up close: block {Z.block}, rows {Z.from} to {Z.to}, with row numbers on the left. The flag on row {OLD_NOTE.row}{' '}
        is an older note, and it stays when next season’s marks start fresh.
      </figcaption>
    </figure>

    <figure class="shot fm-shot" data-stage-shot>
      <Phone label={phoneLabel}>
        <div class="screens" data-screens>
          <Screen stateId="trees-1415-block2" alt={phoneLabel} tone="light" final>
            <TreesTab block={Z.block} rows={[Z.from, Z.to]} />
          </Screen>
        </div>
      </Phone>
      <figcaption>The same rows in the Trees tab. Tap a row number, or pick One, Fill or Erase.</figcaption>
    </figure>

    <div class="fm-haze motion-only" aria-hidden="true" data-field-haze></div>
  </Fragment>

  <ul slot="extras" class="fm-cards" data-field-cards>
    <li class="fm-card" data-field-card="1">
      <span class="fm-card-icon num" aria-hidden="true">{nextRow}</span>
      <p>Tap a row number to mark the whole row.</p>
    </li>
    <li class="fm-card" data-field-card="2">
      <span class="fm-card-icon" aria-hidden="true"><Icon name="undo" size="20px" /></span>
      <p>
        Zoom from the whole field down to big dots that are easy to hit. Mark one tree, fill between two trees, or erase.
        Undo is one tap.
      </p>
    </li>
    <li class="fm-card" data-field-card="3">
      <span class="fm-card-icon" aria-hidden="true">
        <svg class="sw-flag" viewBox="0 0 24 24" focusable="false"><path d={FLAG_PATH}></path></svg>
      </span>
      <p>Marks start fresh each season. Notes stay with the tree.</p>
    </li>
  </ul>

  <div slot="after" class="wrap fm-after">
    <TryIt />
  </div>
</SectionShell>

<style>
  /* ---------- Shared pieces ---------- */
  .fm-fig {
    margin: 0;
    min-width: 0;
    position: relative;
  }
  .fm-fig figcaption {
    margin-top: 14px;
    max-width: 52ch;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--on-stage-muted);
  }

  /* Legend swatches: the page map's dots (gold 20% larger, a 1.5px ring), and the rust flag. */
  .sw {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    vertical-align: 0.02em;
  }
  .sw-today {
    width: 12px;
    height: 12px;
    background: var(--dot-today);
  }
  .sw-earlier {
    background: var(--dot-earlier);
  }
  .sw-ring {
    box-shadow: inset 0 0 0 1.5px var(--dot-ring);
  }
  .sw-flag {
    flex: none;
    width: 16px;
    height: 16px;
    fill: #c2462a;
    stroke: var(--on-stage);
    stroke-width: 1.6px;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .fm-key {
    white-space: nowrap;
  }
  .fm-key .sw {
    margin-right: 0.4em;
  }

  .fm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .fm-counts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.2;
    color: var(--on-stage);
    font-variant-numeric: tabular-nums;
  }
  .fm-count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5ch;
    white-space: nowrap;
  }
  .fm-n {
    justify-content: flex-end;
    min-width: calc(var(--w) * 1ch);
  }
  .fm-count--today .fm-n {
    color: var(--gold-lit);
  }
  .fm-l {
    color: var(--on-stage-muted);
  }
  .fm-sep {
    color: var(--on-stage-muted);
  }

  .fm-season {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 14px 0 12px;
    border-radius: 999px;
    background: var(--card-dark);
    border: 1px solid var(--stage-line);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 13px;
    color: var(--on-stage);
  }
  .fm-season :global(.icon) {
    color: var(--fir-lit);
  }
  .fm-season-clip {
    display: inline-block;
    height: 1.3em;
    line-height: 1.3em;
    overflow: hidden;
  }
  .fm-season-col {
    display: flex;
    flex-direction: column;
  }

  .fm-cam {
    position: relative;
    min-width: 0;
  }
  /* The close-up's vignette: the stage tint itself over the box's edges, so the dimmed context
     fades into the page (the scene aligns the gradient to the viewport; opacity follows the camera). */
  .fm-edges {
    position: absolute;
    inset: -1px;
    pointer-events: none;
    opacity: 0;
    background-image: var(--tint-field);
    background-repeat: no-repeat;
    background-size: 100% var(--edge-vh, 100svh);
    background-position: 0 var(--edge-y, 0px);
    --ex: 112px;
    --ey: 72px;
    -webkit-mask-image:
      linear-gradient(90deg, #000, transparent var(--ex), transparent calc(100% - var(--ex)), #000),
      linear-gradient(180deg, #000, transparent var(--ey), transparent calc(100% - var(--ey)), #000);
    mask-image:
      linear-gradient(90deg, #000, transparent var(--ex), transparent calc(100% - var(--ex)), #000),
      linear-gradient(180deg, #000, transparent var(--ey), transparent calc(100% - var(--ey)), #000);
  }
  @media (max-width: 899.98px) {
    /* On a phone the close-up fills the width: soften only the very edges. */
    .fm-edges {
      --ex: 14px;
      --ey: 44px;
    }
  }
  .fm-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fm-undo {
    position: absolute;
    left: var(--ux, 75%);
    top: var(--uy, 50%);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px 0 11px;
    margin-top: -18px;
    border-radius: 999px;
    background: #f2f5ef;
    color: var(--ink);
    font-weight: 600;
    font-size: 15px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    opacity: 0;
    white-space: nowrap;
  }

  .fm-foot {
    margin-top: 16px;
  }
  .fm-legend {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
    line-height: 1.3;
    color: var(--on-stage);
  }
  .fm-legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
  }
  .fm-legend .sw {
    margin-inline: 1px;
  }

  /* The three points (cards under motion, a plain list without). */
  .fm-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 20px;
  }
  .fm-card {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }
  .fm-card p {
    color: var(--on-stage);
    font-size: 1.0625rem;
    line-height: 1.5;
    max-width: 40ch;
  }
  .fm-card-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(136, 207, 164, 0.1);
    color: var(--gold-lit);
    font-size: 15px;
    font-weight: 600;
  }
  .fm-card-icon .sw-flag {
    width: 20px;
    height: 20px;
  }

  .fm-after {
    padding-block: 24px 112px;
  }

  /* Narrow screens: the counter strip becomes three stats, the legend tightens. */
  @media (max-width: 599.98px) {
    .fm-counts {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      width: 100%;
      gap: 0;
      font-size: 20px;
    }
    .fm-sep {
      display: none;
    }
    .fm-count {
      display: grid;
      gap: 2px;
    }
    .fm-n {
      justify-content: flex-start;
    }
    .fm-l {
      font-family: var(--font-body);
      font-size: 12px;
    }
    .fm-season {
      margin-left: auto;
    }
    .fm-legend {
      gap: 6px 14px;
      font-size: 12.5px;
      justify-content: center;
    }
  }

  /* ---------- STATIC: no motion (reduced motion, no JS) ---------- */
  :global(html:not(.motion) #field .frame),
  :global(html:not(.motion) #field .frame-grid),
  :global(html:not(.motion) #field .figure-slot),
  :global(html:not(.motion) #field .extras) {
    display: contents;
  }
  :global(html:not(.motion)) .fm-overview {
    order: 1;
  }
  :global(html:not(.motion)) .fm-zoomfig {
    order: 2;
    width: min(100%, 420px);
    justify-self: center;
  }
  :global(html:not(.motion)) .fm-cards {
    order: 3;
    padding-left: 2px;
  }
  :global(html:not(.motion)) .fm-shot {
    order: 4;
  }
  /* The close-up's dimmed context fades out at the edges instead of stopping at a hard line. */
  :global(html:not(.motion)) .fm-zoommap {
    -webkit-mask-image:
      linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent),
      linear-gradient(180deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent),
      linear-gradient(180deg, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  @media (min-width: 900px) {
    :global(html:not(.motion) #field .beats) {
      grid-row: 1;
    }
    :global(html:not(.motion)) .fm-shot {
      grid-column: 7 / -1;
      grid-row: 1;
    }
    :global(html:not(.motion)) .fm-overview {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 24px;
    }
    :global(html:not(.motion)) .fm-zoomfig {
      grid-column: 1 / span 5;
      grid-row: 3;
      width: 100%;
    }
    :global(html:not(.motion)) .fm-cards {
      grid-column: 7 / -1;
      grid-row: 3;
      align-self: center;
      gap: 28px;
    }
  }

  /* ---------- MOTION, both layouts ---------- */
  :global(html.motion #field .frame) {
    overflow: clip;
  }
  :global(html.motion) .fm-fig figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  :global(html.motion) .fm-cam {
    transform-origin: 50% 100%;
  }
  :global(html.motion) .fm-cam :global(.fieldmap) {
    height: 100%;
    aspect-ratio: auto;
  }
  :global(html.motion) .fm-top {
    margin: 0;
  }
  :global(html.motion) .fm-foot {
    margin: 0;
  }
  /* The horizon haze over the tilted field's far rows: a flat mid-tint with soft edges, so it never
     shows a seam wherever the frame sits (on phones it rises with the frame). */
  .fm-haze {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: #09160e;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 12%, #000 36%, transparent 64%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 12%, #000 36%, transparent 64%);
  }
  :global(html.motion) .fm-card {
    background: var(--card-dark);
    border: 1px solid var(--stage-line);
    border-radius: var(--radius-card);
    padding: 16px 18px;
    box-shadow: 0 18px 40px rgba(2, 8, 5, 0.45);
    align-items: center;
  }
  :global(html.motion) .fm-card p {
    font-size: 1rem;
  }
  /* The scene fades each card in at its beat. */
  :global(html.motion) .fm-card {
    opacity: 0;
  }

  /* ---------- MOTION, desktop (≥900px): the full-bleed field ---------- */
  @media (min-width: 900px) {
    :global(html.motion #field .beat-head) {
      --anchor: 40svh;
    }
    :global(html.motion #field .frame-grid) {
      display: block;
      max-width: none;
      height: 100%;
      padding: 0;
    }
    :global(html.motion #field .figure-slot) {
      display: block;
      position: absolute;
      inset: 0;
    }
    :global(html.motion) .fm-overview {
      --foot-h: 112px;
      position: absolute;
      top: calc(var(--chrome-h) + 44px);
      bottom: 24px;
      left: 0;
      right: 0;
      margin-inline: auto;
      width: min(1180px, 92%);
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) var(--foot-h);
      row-gap: 16px;
    }
    :global(html.motion) .fm-cards {
      position: absolute;
      right: calc((100% - min(1180px, 92%)) / 2);
      bottom: 24px;
      width: min(470px, 42%);
      height: 112px;
      display: block;
    }
    :global(html.motion) .fm-card {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
    }
    /* Try it sits in the left columns, beside the stage phone (back on the Trees tab). */
    :global(html.motion) .fm-after {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    :global(html.motion) .fm-after > :global(*) {
      grid-column: 1 / span 6;
    }
  }

  /* ---------- MOTION, mobile (<900px): the field fills the sticky frame ---------- */
  @media (max-width: 899.98px) {
    :global(html.motion #field .frame) {
      height: calc(100svh - var(--sticky-top-mob));
    }
    :global(html.motion #field .frame-grid),
    :global(html.motion #field .figure-slot) {
      display: block;
      position: relative;
      height: 100%;
    }
    :global(html.motion) .fm-overview {
      --sheet-h: 148px;
      height: 100%;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto var(--sheet-h);
      row-gap: 10px;
      padding-bottom: 12px;
    }
    :global(html.motion) .fm-top {
      display: block;
    }
    :global(html.motion) .fm-counts {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      gap: 0;
      font-size: 20px;
    }
    :global(html.motion) .fm-sep {
      display: none;
    }
    :global(html.motion) .fm-count {
      display: grid;
      gap: 2px;
    }
    :global(html.motion) .fm-n {
      justify-content: flex-start;
    }
    :global(html.motion) .fm-l {
      font-family: var(--font-body);
      font-size: 12px;
    }
    /* On a phone the season chip shows only for the season beat, over the close-up's dimmed top. */
    :global(html.motion) .fm-season {
      position: absolute;
      top: 72px;
      right: 0;
      z-index: 2;
      min-height: 30px;
      font-size: 12px;
      opacity: 0;
    }
    :global(html.motion) .fm-legend {
      gap: 6px 14px;
      font-size: 12.5px;
      justify-content: center;
    }
    :global(html.motion) .fm-cards {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      bottom: 12px;
      height: 148px;
      display: block;
    }
    :global(html.motion) .fm-card {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
    }
    /* The section's own phone comes back over the map at the end. */
    :global(html.motion) .fm-shot {
      position: absolute;
      inset: 0 0 12px;
      display: grid;
      place-items: center;
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
