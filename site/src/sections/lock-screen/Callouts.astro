---
/**
 * CALLOUTS (desktop with motion): six real-text labels around the zoomed stage phone, three
 * a side, each tied to its feature by a 1px gold leader line with a dot at the feature, plus
 * the ghost 'Clock out' button level with the button row. The scene lays them out from
 * model.deskLayout() (viewport px) and draws them in; without motion, and on mobile, they are
 * not shown (the numbered notes list says the same thing).
 *
 * Hooks: [data-ls-callouts] (root), [data-callout="1".."6"] (the labels, real text),
 * [data-line-for="n"] > [data-line] (path, pathLength 1) and [data-dot], [data-ls-ghost].
 */
import { CALLOUTS } from './model.ts';
import Ghost from './Ghost.astro';
---

<div class="callouts" data-ls-callouts>
  <svg class="lines" aria-hidden="true" focusable="false">
    {
      CALLOUTS.map((c) => (
        <g data-line-for={c.n}>
          <path data-line pathLength="1" d="M0 0" />
          <circle data-dot r="4" cx="0" cy="0" />
        </g>
      ))
    }
  </svg>
  <ul class="labels" aria-label="What the Live Activity shows">
    {
      CALLOUTS.map((c) => (
        <li class:list={['label', `label--${c.side}`, c.sub && 'label--two']} data-callout={c.n} data-side={c.side}>
          <span class="pill">
            <span class="label-main">{c.label}</span>
            {c.sub && <span class="label-sub"> {c.sub}</span>}
          </span>
        </li>
      ))
    }
  </ul>
  <div class="ghost-at" data-ls-ghost-at>
    <Ghost variant="desk" />
  </div>
</div>

<style>
  .callouts {
    display: none;
  }
  @media (min-width: 900px) {
    :global(html.stage-on) .callouts {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .lines path {
    fill: none;
    stroke: var(--gold-lit);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .lines circle {
    fill: var(--gold-lit);
    stroke: rgba(8, 20, 13, 0.85);
    stroke-width: 2;
  }

  .labels {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Placed by the scene: --x is the edge nearest the phone, --y the centre line (or the top,
     for the one under the ghost). Each li is a zero-height row on that line, so its own
     transform stays free for the slide-in (no CSS translate: GSAP folds that into its own). */
  .label {
    position: absolute;
    top: calc(var(--y, 0) * 1px);
    height: 0;
    display: flex;
    align-items: center;
  }
  .label--left {
    right: calc(100% - var(--x, 0) * 1px);
    justify-content: flex-end;
  }
  .label--right {
    left: calc(var(--x, 0) * 1px);
  }
  .label--two {
    align-items: flex-start;
  }
  /* A --card-dark pill: Public Sans 600 16px in cream. */
  .pill {
    display: block;
    flex: none;
    max-width: calc(var(--max, 300) * 1px);
    width: max-content;
    padding: 10px 16px;
    border-radius: 22px;
    background: var(--card-dark);
    border: 1px solid var(--stage-line);
    box-shadow: 0 10px 28px -12px rgba(0, 0, 0, 0.6);
    color: var(--on-stage);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
  }
  .label--left .pill {
    text-align: right;
  }
  .label--two .pill {
    border-radius: 18px;
    padding: 12px 16px;
  }
  .label-sub {
    display: block;
    margin-top: 2px;
    font-weight: 400;
    color: var(--on-stage-muted);
  }

  .ghost-at {
    position: absolute;
    left: calc(var(--x, 0) * 1px);
    top: calc(var(--y, 0) * 1px);
    height: 0;
    display: flex;
    align-items: center;
  }
</style>
