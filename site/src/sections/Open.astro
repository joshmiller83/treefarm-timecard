---
/**
 * BUILT IN THE OPEN · the honest close. A light section of natural height (no sticky track).
 * Spec: jq '.sections[] | select(.id=="open")' docs/landing/brief.json, decisions.md #5 and #6.
 *
 * Static first: this markup is the final state. The scene (src/scripts/scenes/open.ts) only
 * adds from-states for elements still below the fold when it builds, then plays each part
 * once as it comes into view: the icon assembles, the headline mask-reveals by line, the
 * copy fades up, the status rail fills to "now", and the terminal types its command once.
 *
 * Hooks: [data-open-lockup], [data-open-icon] > [data-icon-shadow] [data-icon-sheen] and the
 * AppIcon parts, [data-open-rail] > [data-rail-fill] [data-step], [data-open-term] >
 * [data-term-cmd] [data-term-char] [data-term-cursor] [data-copy], and [data-reveal] blocks.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import SectionShell from '../components/SectionShell.astro';
import AppIcon from '../components/AppIcon.astro';
import Icon from '../components/app/Icon.astro';
import { COMMAND, DOCS, REPO, STACK, STATUS, commandTokens, railFill, readmeHasCommand } from './open/open.ts';

// The terminal card renders only if the repo README really shows the command (brief: open).
// The build runs in site/, so the README is one level up.
let hasCommand = false;
try {
  hasCommand = readmeHasCommand(readFileSync(join(process.cwd(), '..', 'README.md'), 'utf8'));
} catch {
  hasCommand = false;
}
const tokens = commandTokens(COMMAND);
const fill = railFill(STATUS);
---

<SectionShell id="open">
  <Fragment slot="intro">
    <p class="lede" data-reveal>
      Time Card grew out of a simple web time card used on a working Christmas tree farm in Indiana. The iPhone app is
      the next step.
    </p>
    <p class="status" data-reveal>It’s in active development. A TestFlight beta is coming. Nothing is on the App Store yet.</p>

    <div class="rail" data-open-rail data-reveal style={`--fill:${fill.toFixed(4)};--steps:${STATUS.length}`}>
      <span class="rail-line" aria-hidden="true"><span class="rail-fill" data-rail-fill></span></span>
      <ol class="rail-steps" aria-label="Where it stands">
        {
          STATUS.map((s) => (
            <li class="step" data-step={s.state}>
              <span class="dot" aria-hidden="true" data-dot />
              <span class="step-title">{s.title}</span>
              <span class="sr-only">: </span>
              <span class="step-note">{s.note}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="dev">
      <h3 class="dev-h" data-reveal>For developers</h3>
      <p data-reveal>
        The code is open source under the MIT license. It’s Swift all the way through: a SwiftUI app that works with
        Siri through App Intents and puts your timer on the lock screen with ActivityKit, plus a small Vapor and SQLite
        server your farm runs itself. Ours runs on a Mac at home behind a Cloudflare Tunnel. Every rule is written
        test-first.
      </p>
      <ul class="stack" aria-label="The stack">
        {STACK.map((s) => <li class="chip" data-reveal data-chip>{s}</li>)}
      </ul>
      {
        hasCommand && (
          <div class="term" data-open-term data-reveal>
            <div class="term-bar">
              <span class="term-label">Run the tests</span>
              <button class="copy" type="button" data-copy data-command={COMMAND} hidden>
                <svg class="copy-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <g data-glyph-copy>
                    <rect x="5.25" y="5.25" width="8" height="8" rx="2" />
                    <path d="M10.75 3.25V3a1.75 1.75 0 0 0-1.75-1.75H4A1.75 1.75 0 0 0 2.25 3v5A1.75 1.75 0 0 0 4 9.75h.25" />
                  </g>
                  <path data-glyph-check d="M3.5 8.5l3 3 6-7" />
                </svg>
                <span data-copy-label aria-hidden="true">Copy</span>
                <span class="sr-only">Copy the command</span>
              </button>
            </div>
            <div class="term-line">
              <span class="sr-only" data-term-sr>{COMMAND}</span>
              <span class="prompt" aria-hidden="true" />
              {/* One character per span, written without whitespace between them. */}
              <code class="cmd" aria-hidden="true" data-term-cmd>{tokens.map((t, k) => t.space ? <span class="ch" data-term-char={t.chars[0]!.i}>{' '}</span> : <span class="tok">{t.chars.map((c) => <span class="ch" data-term-char={c.i}>{c.ch}</span>)}{k === tokens.length - 1 && <span class="cursor" data-term-cursor />}</span>)}</code>
            </div>
            <span class="sr-only" role="status" data-copy-status />
          </div>
        )
      }
    </div>

    <div class="cta" data-open-cta>
      <a class="btn btn-fir" href={REPO} rel="noopener" data-reveal>
        Follow along on GitHub
        <Icon name="arrow.up.right" size="18px" weight={2.2} />
      </a>
      <a class="btn btn-ghost" href={DOCS} rel="noopener" data-reveal>
        Read the docs
        <Icon name="arrow.up.right" size="18px" weight={2.2} />
      </a>
    </div>
    <p class="follow" data-reveal>Follow along on GitHub for news about the beta.</p>
  </Fragment>

  <div slot="figure" class="lockup" data-open-lockup>
    <div class="icon" data-open-icon>
      <span class="icon-shadow" data-icon-shadow aria-hidden="true"></span>
      <AppIcon size="var(--icon)" uid="open-icon" />
      <span class="icon-clip" aria-hidden="true"><span class="icon-sheen" data-icon-sheen data-transient></span></span>
    </div>
    <p class="lockup-name" data-lockup-text>Time Card</p>
    <p class="lockup-sub" data-lockup-text>For Christmas tree trimmers</p>
  </div>
</SectionShell>

<script>
  // The motion core scrolls a focused element's beat to the middle of the screen. This
  // section is one natural-height beat, taller than the viewport, so that scroll would fire
  // on every mousedown here and the click would land somewhere else. The browser already
  // keeps a focused element in view, so focus events stay inside this section.
  document.getElementById('open')?.addEventListener('focusin', (e) => e.stopPropagation());

  // Copy the command (progressive: the button stays hidden without the Clipboard API).
  const btn = document.querySelector<HTMLButtonElement>('#open [data-copy]');
  const status = document.querySelector<HTMLElement>('#open [data-copy-status]');
  if (btn && navigator.clipboard && window.isSecureContext) {
    btn.hidden = false;
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    let timer = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.command ?? '');
      } catch {
        return;
      }
      btn.dataset.copied = '';
      if (label) label.textContent = 'Copied';
      if (status) status.textContent = 'Copied';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete btn.dataset.copied;
        if (label) label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  /* ---------- Layout (SectionShell's elements, scoped to this section) ---------- */
  :global(#open) {
    --icon: 128px;
  }
  :global(#open .track) {
    row-gap: 40px;
  }
  @media (max-width: 899.98px) {
    /* Mobile: the icon first, centered, then the copy. */
    :global(#open .frame) {
      order: -1;
    }
  }
  @media (min-width: 900px) {
    :global(#open) {
      --icon: 192px;
    }
    /* Desktop: the icon in columns 1–4 (it rides along while the copy scrolls), copy in 5–11. */
    :global(#open .track) {
      align-items: start;
    }
    :global(#open .frame) {
      grid-column: 1 / span 4;
      grid-row: 1;
      position: sticky;
      top: calc(var(--chrome-h) + 64px);
    }
    :global(#open .beats) {
      grid-column: 5 / span 7;
      grid-row: 1;
      max-width: none;
    }
    :global(#open .beat-intro > p) {
      max-width: 36ch;
    }
  }
  :global(#open .beat-intro) {
    gap: 22px;
  }

  /* SplitText's line masks (motion only): room for descenders while the lines rise. */
  :global(#open .open-line-mask) {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }

  /* ---------- Copy ---------- */
  .lede,
  .status {
    color: var(--ink);
  }
  :global(#open .beat-intro > p.follow) {
    max-width: none;
  }
  .follow {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--muted);
    margin-top: -6px;
  }

  /* ---------- The lockup: icon, name, audience ---------- */
  .lockup {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0;
  }
  .icon {
    position: relative;
    width: var(--icon);
    height: var(--icon);
    border-radius: 22.46%; /* the icon's 230/1024 corner */
  }
  .icon :global(.app-icon) {
    position: relative;
  }
  /* The icon's shadow is its own pre-baked layer (scenes fade its opacity, never the shadow). */
  .icon-shadow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      0 1px 1px rgba(20, 34, 26, 0.08),
      0 10px 20px -6px rgba(20, 34, 26, 0.22),
      0 28px 56px -18px rgba(21, 74, 46, 0.45);
  }
  .icon-clip {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }
  /* A one-time specular sweep when the icon finishes (the page's screen-change sheen). */
  .icon-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 28%, rgba(255, 255, 255, 0.24) 50%, transparent 72%);
    opacity: 0;
  }
  .lockup-name,
  .lockup-sub {
    display: none;
  }
  @media (min-width: 900px) {
    .lockup-name {
      display: block;
      margin-top: 28px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.75rem;
      line-height: 1.1;
      letter-spacing: -0.01em;
      color: var(--ink);
    }
    .lockup-sub {
      display: block;
      margin-top: 6px;
      font-size: var(--text-small);
      line-height: 1.4;
      color: var(--muted);
    }
  }

  /* ---------- Where it stands: the status rail ---------- */
  .rail {
    --dot: 12px;
    --row: 56px;
    position: relative;
    margin-block: 6px 4px;
  }
  .rail-steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-auto-rows: var(--row);
  }
  .rail-line {
    position: absolute;
    /* from the first dot's centre to the last one's */
    left: calc(var(--dot) / 2);
    top: calc(var(--dot) / 2 + 6px);
    width: 2px;
    height: calc((var(--steps) - 1) * var(--row));
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--fir-mid), #6faa63 70%, var(--gold-lit));
    transform-origin: 50% 0;
    transform: scaleY(var(--fill));
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: calc(var(--dot) + 2px) minmax(0, 1fr);
    column-gap: 16px;
    align-content: start;
  }
  .dot {
    grid-row: 1 / span 2;
    position: relative;
    z-index: 1;
    margin-top: 6px;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    justify-self: center;
  }
  .step[data-step='done'] .dot {
    background: var(--fir);
  }
  /* "Now" is gold and 20% larger, as on the field map, with a soft static halo. */
  .step[data-step='now'] .dot {
    --d: calc(var(--dot) * 1.2);
    width: var(--d);
    height: var(--d);
    margin-top: calc(6px - (var(--d) - var(--dot)) / 2);
    background: var(--gold);
    box-shadow: 0 0 0 5px rgba(226, 166, 68, 0.28);
  }
  /* One ring rolls out from "now" as the rail arrives (the scene adds it; motion only). */
  :global(#open .open-ripple) {
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 2px solid var(--gold-lit);
    opacity: 0;
  }
  .step[data-step='next'] .dot {
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px #6f8f7a;
  }
  .step-title {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .step-note {
    font-size: var(--text-small);
    line-height: 1.4;
    color: var(--muted);
  }
  .step[data-step='now'] .step-note {
    color: var(--sap-ink);
    font-weight: 600;
  }
  /* Across, like the shift ribbon: wherever the copy column is wide enough for four stops
     (a wide single column from 600px, and the desktop copy column from 1100px). */
  @media (min-width: 600px) and (max-width: 899.98px), (min-width: 1100px) {
    .rail-steps {
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
      grid-auto-rows: auto;
      column-gap: 12px;
    }
    .rail-line {
      left: calc(var(--dot) / 2);
      top: calc(var(--dot) / 2 - 1px);
      width: calc((100% + 12px) * (var(--steps) - 1) / var(--steps));
      height: 2px;
    }
    .rail-fill {
      background: linear-gradient(90deg, var(--fir-mid), #6faa63 70%, var(--gold-lit));
      transform-origin: 0 50%;
      transform: scaleX(var(--fill));
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }
    .dot {
      grid-row: auto;
      justify-self: start;
      margin-top: 0;
      margin-bottom: 14px;
    }
    .step[data-step='now'] .dot {
      margin-top: calc((var(--dot) - var(--d)) / 2);
      margin-bottom: calc(14px + (var(--dot) - var(--d)) / 2);
      margin-left: calc((var(--dot) - var(--d)) / 2);
    }
  }

  /* ---------- For developers ---------- */
  .dev {
    display: grid;
    gap: 20px;
    margin-top: 14px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }
  .dev > p {
    max-width: 38ch;
    color: var(--muted);
  }
  .dev-h {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-eyebrow);
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fir);
    text-wrap: initial;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }
  .stack .chip {
    min-height: 34px;
    padding: 6px 12px;
    font-size: 0.8125rem;
  }

  /* ---------- The terminal card ---------- */
  .term {
    max-width: 34rem;
    border-radius: 12px;
    background: #14221a;
    color: #f2f5ef;
    padding: 6px 18px 18px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 16px 32px -20px rgba(20, 34, 26, 0.6);
    --focus: var(--gold-lit);
  }
  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(136, 207, 164, 0.14);
  }
  .term-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-stage-muted);
  }
  .copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    margin-right: -8px;
    padding: 4px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--on-stage-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  /* 44px touch target around the 30px chip */
  .copy::after {
    content: '';
    position: absolute;
    inset: -7px -4px;
  }
  .copy:hover {
    color: var(--on-stage);
    background: rgba(242, 245, 239, 0.06);
  }
  .copy[data-copied] {
    color: var(--fir-lit);
  }
  .copy-glyph {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copy [data-glyph-check],
  .copy[data-copied] [data-glyph-copy] {
    display: none;
  }
  .copy[data-copied] [data-glyph-check] {
    display: inline;
  }
  .term-line {
    display: flex;
    gap: 1ch;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  /* The '$' prompt is CSS content, so the page's text never contains a dollar sign. */
  .prompt::before {
    content: '$';
    color: var(--gold-lit);
  }
  .cmd {
    min-width: 0;
    font: inherit;
    color: #f2f5ef;
  }
  .tok {
    white-space: nowrap;
  }
  .cursor {
    display: inline-block;
    width: 0.62em;
    height: 1.2em;
    margin-left: 2px;
    vertical-align: -0.24em;
    background: var(--fir-lit);
    border-radius: 1px;
  }

  /* ---------- The call to action ---------- */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 18px;
  }
  .cta .btn {
    min-height: 52px;
    padding-inline: 24px;
  }
  .cta .btn :global(.icon) {
    width: 18px;
    height: 18px;
    margin-right: -4px;
  }
  @media (max-width: 599.98px) {
    .cta {
      flex-direction: column;
    }
    .cta .btn {
      width: 100%;
    }
  }
</style>
