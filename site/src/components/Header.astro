---
/**
 * HEADER: skip link, DayMark + wordmark, the honest status pill, GitHub, Pause motion,
 * and under it <nav aria-label="The shift">: the 3px shift ribbon, its riding time tag and
 * the nine chapter links (ticks on desktop with motion, a plain list without, a disclosure
 * panel on mobile). Behaviour: src/scripts/header.ts. DayClock drives --p and the tag.
 */
import { CHAPTERS } from '../data/chapters.ts';
import DayMark from './DayMark.astro';
import Icon from './app/Icon.astro';

const REPO = 'https://github.com/joshmiller83/treefarm-timecard';
const n = CHAPTERS.length - 1;
---

<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header" data-header data-theme="dark">
  <div class="bar">
    <a class="brand" href="/" aria-label="Time Card home">
      <DayMark />
      <span class="wordmark" aria-hidden="true">Time Card</span>
    </a>
    <div class="right">
      <span class="pill-status hdr-pill">
        <span>In development</span><span class="pill-more">&nbsp;· TestFlight beta coming</span>
      </span>
      <a class="gh" href={REPO} rel="noopener">GitHub</a>
      <button class="pause" type="button" aria-pressed="false" data-pause-toggle>
        <Icon name="pause" size="18px" class="i-pause" />
        <Icon name="play" size="18px" class="i-play" />
        <span class="pause-tip">Pause motion</span>
      </button>
    </div>
  </div>

  <nav class="shift" aria-label="The shift" style="--p:0">
    <div class="ribbon" aria-hidden="true">
      <span class="ribbon-fill"></span>
    </div>
    <span class="shift-tag tag-ride" aria-hidden="true" data-shift-tag>{CHAPTERS[0]!.ribbonTag}</span>
    <button class="shift-toggle" type="button" aria-expanded="false" aria-controls="shift-list">
      <span class="sr-only">Chapters: </span><span data-shift-tag>{CHAPTERS[0]!.ribbonTag}</span>
      <Icon name="chevron.down" size="14px" class="chev" weight={2.2} />
    </button>
    <ol class="shift-list" id="shift-list">
      {
        CHAPTERS.map((c, i) => (
          <li style={`--i:${i / n}`}>
            <a href={`#${c.id}`} data-chapter-link={c.id}>
              <span class="tick" aria-hidden="true" />
              <span class="lbl">{c.navLabel}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</header>

<script>
  import { initHeader } from '../scripts/header.ts';
  initHeader();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--chrome-h);
    color: var(--on-stage);
    background: #08140d;
    background: rgba(8, 20, 13, 0.9);
    transition:
      background-color 0.3s linear,
      color 0.3s linear;
    --ribbon-pad: 28px;
  }
  .site-header[data-theme='light'] {
    background: rgba(236, 241, 236, 0.94);
    color: var(--ink);
    --focus: var(--fir);
  }
  .bar {
    height: var(--header-h);
    max-width: calc(var(--maxw) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    text-decoration: none;
    color: inherit;
    flex: none;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .hdr-pill {
    font-size: 0.6875rem;
    padding: 4px 9px;
    min-height: 26px;
  }
  .hdr-pill::before {
    display: none;
  }
  .pill-more {
    display: none;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 6px;
    font-weight: 600;
    font-size: 0.9375rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    text-decoration-thickness: 1.5px;
  }
  .gh:hover {
    text-decoration-color: currentColor;
  }
  .pause {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -6px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: inherit;
  }
  .pause:hover {
    background: rgba(242, 245, 239, 0.08);
  }
  [data-theme='light'] .pause:hover {
    background: rgba(20, 34, 26, 0.06);
  }
  .pause :global(.i-play),
  .pause[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }
  .pause[aria-pressed='true'] :global(.i-play) {
    display: block;
  }
  .pause-tip {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--on-stage);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.15s linear,
      transform 0.15s var(--ease-out);
  }
  .pause:hover .pause-tip,
  .pause:focus-visible .pause-tip {
    opacity: 1;
    transform: none;
  }

  /* ---------- The shift nav ---------- */
  .shift {
    position: relative;
    height: var(--ribbon-h);
  }
  .ribbon {
    position: absolute;
    inset: 0;
    background: rgba(136, 207, 164, 0.16);
    overflow: hidden;
  }
  [data-theme='light'] .ribbon {
    background: rgba(29, 91, 58, 0.16);
  }
  .ribbon-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--fir-mid) 0%, #6faa63 55%, var(--gold-lit) 100%);
    transform: translateX(calc((var(--p) - 1) * (100% - 2 * var(--ribbon-pad)) - var(--ribbon-pad)));
  }
  .tag-ride {
    position: absolute;
    top: 8px;
    left: calc(var(--ribbon-pad) + (100% - 2 * var(--ribbon-pad)) * var(--p));
    transform: translateX(calc(var(--p) * -100%));
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(8, 20, 13, 0.82);
    border: 1px solid var(--stage-line);
    color: var(--gold-lit);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  [data-theme='light'] .tag-ride {
    background: rgba(250, 252, 249, 0.92);
    border-color: var(--line);
    color: var(--fir);
  }
  .shift-toggle {
    display: none;
  }
  .shift-list {
    list-style: none;
    padding: 0;
  }
  .lbl {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Without motion the ribbon fill and riding tag are hidden; the links remain. */
  :global(html:not(.motion)) .ribbon-fill,
  :global(html:not(.motion)) .tag-ride {
    display: none;
  }

  /* ---------- Mobile (<900px): a disclosure under the header ---------- */
  @media (max-width: 899.98px) {
    .tag-ride {
      display: none;
    }
    .shift-toggle {
      position: absolute;
      top: 7px;
      left: calc(var(--ribbon-pad) + (100% - 2 * var(--ribbon-pad)) * var(--p));
      transform: translateX(calc(var(--p) * -100%));
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 32px;
      padding: 4px 10px 4px 12px;
      border-radius: 999px;
      border: 1px solid var(--stage-line);
      background: rgba(8, 20, 13, 0.9);
      color: var(--gold-lit);
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    /* 44px touch target around the 32px chip */
    .shift-toggle::after {
      content: '';
      position: absolute;
      inset: -6px -2px;
    }
    :global(html:not(.motion)) .shift-toggle {
      left: auto;
      right: 12px;
      transform: none;
    }
    [data-theme='light'] .shift-toggle {
      background: rgba(250, 252, 249, 0.95);
      border-color: var(--line);
      color: var(--fir);
    }
    .shift-toggle :global(.chev) {
      transition: transform 0.2s var(--ease-out);
    }
    .shift-toggle[aria-expanded='true'] :global(.chev) {
      transform: rotate(180deg);
    }
    .shift-list {
      position: absolute;
      top: 46px;
      left: 12px;
      right: 12px;
      display: none;
      padding: 8px;
      border-radius: 18px;
      background: #0e2117;
      border: 1px solid var(--stage-line);
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
    }
    [data-theme='light'] .shift-list {
      background: var(--surface);
      border-color: var(--line);
      box-shadow: 0 18px 48px rgba(20, 34, 26, 0.18);
    }
    .shift.is-open .shift-list {
      display: grid;
    }
    .shift-list a {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 44px;
      padding: 0 12px;
      border-radius: 12px;
      color: inherit;
      text-decoration: none;
    }
    .shift-list a:hover,
    .shift-list a[aria-current] {
      background: rgba(136, 207, 164, 0.1);
    }
    .shift-list .tick {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 1.5px solid var(--fir-lit);
      flex: none;
    }
    .shift-list a.reached .tick {
      background: var(--gold-lit);
      border-color: var(--gold-lit);
    }
    .lbl {
      font-size: 0.875rem;
    }
  }
  @media (max-width: 599.98px) {
    .wordmark {
      font-size: 1.0625rem;
    }
  }
  @media (max-width: 359.98px) {
    .wordmark {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (min-width: 600px) {
    .pill-more {
      display: inline;
    }
    .hdr-pill {
      font-size: 0.75rem;
      padding: 4px 12px;
    }
    .hdr-pill::before {
      display: block;
    }
    .bar {
      padding-inline: var(--gutter);
      gap: 16px;
    }
    .right {
      gap: 14px;
    }
    .wordmark {
      font-size: 1.25rem;
    }
  }

  /* ---------- Desktop (≥900px) ---------- */
  @media (min-width: 900px) {
    /* Without motion: a plain list of chapter links under the header. */
    .shift-list {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0 22px;
      padding: 0 var(--gutter);
      background: rgba(8, 20, 13, 0.94);
      border-bottom: 1px solid var(--stage-line);
    }
    [data-theme='light'] .shift-list {
      background: rgba(236, 241, 236, 0.96);
      border-bottom-color: var(--line);
    }
    :global(html:not(.motion)) {
      scroll-padding-top: calc(var(--chrome-h) + 56px);
    }
    :global(html:not(.motion)) .site-header {
      background: rgba(8, 20, 13, 0.94);
    }
    .shift-list a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      color: var(--on-stage-muted);
      text-decoration: none;
    }
    [data-theme='light'] .shift-list a {
      color: var(--muted);
    }
    .shift-list a:hover,
    .shift-list a[aria-current] {
      color: inherit;
    }
    .shift-list .tick {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.6;
    }

    /* With motion: nine ticks on the ribbon; labels show on hover and focus. */
    :global(html.motion) .shift-list {
      top: 0;
      height: 0;
      display: block;
      padding: 0;
      border: 0;
      background: none;
    }
    :global(html.motion) .shift-list li {
      position: absolute;
      top: calc(var(--ribbon-h) / 2);
      left: calc(var(--ribbon-pad) + (100% - 2 * var(--ribbon-pad)) * var(--i));
      transform: translate(-50%, -50%);
    }
    :global(html.motion) .shift-list a {
      position: relative;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      min-height: 0;
    }
    :global(html.motion) .shift-list .tick {
      width: 2px;
      height: 12px;
      border-radius: 1px;
      background: rgba(242, 245, 239, 0.4);
      opacity: 1;
      transition: background-color 0.2s linear;
    }
    :global(html.motion) [data-theme='light'] .shift-list .tick {
      background: rgba(20, 34, 26, 0.35);
    }
    :global(html.motion) .shift-list a.reached .tick {
      background: var(--gold-lit);
    }
    :global(html.motion) [data-theme='light'] .shift-list a.reached .tick {
      background: var(--fir);
    }
    :global(html.motion) .shift-list .lbl {
      position: absolute;
      top: 36px;
      left: 50%;
      transform: translate(-50%, -4px);
      padding: 5px 10px;
      border-radius: 999px;
      background: var(--on-stage);
      color: var(--ink);
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 0.15s linear,
        transform 0.15s var(--ease-out);
    }
    :global(html.motion) .shift-list li:first-child .lbl {
      left: 0;
      transform: translate(0, -4px);
    }
    :global(html.motion) .shift-list li:last-child .lbl {
      left: auto;
      right: 0;
      transform: translate(0, -4px);
    }
    :global(html.motion) .shift-list a:hover .lbl,
    :global(html.motion) .shift-list a:focus-visible .lbl {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    :global(html.motion) .shift-list li:first-child a:is(:hover, :focus-visible) .lbl,
    :global(html.motion) .shift-list li:last-child a:is(:hover, :focus-visible) .lbl {
      transform: none;
    }
    :global(html.motion) .shift-list a:focus-visible {
      outline-offset: -8px;
    }
    .tag-ride {
      top: 9px;
    }
  }
</style>
