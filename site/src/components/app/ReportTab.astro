---
/** STUB (report): replace the content, keep the Props and hooks in CONTRACT.md. */
import AppChrome from './AppChrome.astro';
import Stub from '../dev/Stub.astro';

export interface Props {
  range?: 'This week' | 'Last week' | 'This month' | 'Pick dates';
}
const { range = 'This week' } = Astro.props;
const chips = ['This week', 'Last week', 'This month', 'Pick dates'] as const;
const slug = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
---

<AppChrome title="Report" tab="report" time="4:31">
  <div class="chips">
    {chips.map((c) => <span data-range-chip={slug(c)} data-selected={c === range ? '' : undefined}>{c}</span>)}
  </div>
  <div data-paper-thumb>
    <Stub name="ReportTab" owner="report" tone="light" note="paper preview" box="height:calc(360*var(--pt));" />
  </div>
  <span data-export="pdf">Export PDF</span> <span data-export="csv">CSV</span>
</AppChrome>

<style>
  .chips {
    display: flex;
    gap: calc(6 * var(--pt));
    font-size: calc(13 * var(--pt));
    margin-bottom: calc(10 * var(--pt));
  }
</style>
