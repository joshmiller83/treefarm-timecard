---
/** STUB (map): replace the content, keep the Props and hooks in CONTRACT.md. */
import AppChrome from './AppChrome.astro';
import Stub from '../dev/Stub.astro';
import { FIELD, MOMENTS, fmtClock, type TreeNote } from '../../data/ledger';

export interface Props {
  at?: number;
  block: number;
  rows: [number, number];
  zoom?: 'All' | 'XS' | 'S' | 'M' | 'L';
  mode?: 'one' | 'fill' | 'erase';
  who?: 'Alex' | 'Sam';
  pending?: Array<{ block: number; row: number }>;
  notes?: TreeNote[];
  syncLine?: string | null;
  banner?: string | null;
  noService?: boolean;
  sheet?: TreeNote | null;
}
const { at = MOMENTS.field, block, rows, zoom = 'L', mode = 'one', who = 'Alex', syncLine = null, banner = null, noService = false } = Astro.props;
---

<AppChrome time={fmtClock(at)} title="Trees" tab="trees" subtitle={FIELD.name} noService={noService} trailing={[{ icon: 'undo', id: 'undo' }]}>
  {syncLine && <div data-sync-line>{syncLine}</div>}
  {banner && <div data-banner>{banner}</div>}
  <div data-map data-at={at} data-who={who} data-zoom={zoom} data-mode={mode}>
    <Stub name="TreesTab" owner="map" tone="light" note={`Block ${block} · rows ${rows[0]}–${rows[1]} · zoom ${zoom}`} box="height:calc(470*var(--pt));" />
  </div>
</AppChrome>
