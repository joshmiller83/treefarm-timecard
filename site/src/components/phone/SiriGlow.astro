---
/**
 * SiriGlow (device-b): a soft multicolor light around the screen's inner edge while Siri
 * listens. Generic, not Apple's asset: a conic gradient (--siri-1…4) seen through a mask of
 * the screen edge, 6 pt crisp band plus a short soft bloom inward.
 *
 * Hooks
 *   [data-glow]       the masked layer: animate opacity (and the hero's breathing scale)
 *   [data-glow-ring]  the oversized conic square inside it: animate rotation ('thinking')
 *
 * `still`
 *   true       always the faint static border (reduced-motion figures)
 *   false      always the full glow (lab crops, scenes that want it without html.motion)
 *   omitted    full glow under html.motion, faint static border without it (the static page)
 *
 * Geometry: covers the screen from its top-left corner. It takes 100% of its container's
 * height, or 852 pt when the container has none (LockScreen's top slot is auto-height).
 */
export interface Props {
  /** Reduced motion: a faint static border instead of the glow. */
  still?: boolean;
}
const { still } = Astro.props;
const mode = still === true ? 'still' : still === false ? 'live' : 'auto';
---

<div class="glow" data-glow data-glow-mode={mode} aria-hidden="true">
  <div class="glow-ring" data-glow-ring></div>
</div>

<style>
  .glow {
    /* Edge band (6 pt inside the screen edge) plus a soft bloom, as an alpha mask in the
       393 × 852 pt screen space. Stretched to the layer, so it follows the screen's corners.
       Strokes are centred on the edge, so a 12 pt stroke leaves the still border's 6 pt inside. */
    --glow-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 393 852' preserveAspectRatio='none'><defs><filter id='s' x='-10%25' y='-10%25' width='120%25' height='120%25'><feGaussianBlur stdDeviation='6'/></filter><filter id='e' x='-10%25' y='-10%25' width='120%25' height='120%25'><feGaussianBlur stdDeviation='1.1'/></filter></defs><rect width='393' height='852' rx='50' fill='none' stroke='%23000' stroke-opacity='.42' stroke-width='34' filter='url(%23s)'/><rect width='393' height='852' rx='48' fill='none' stroke='%23000' stroke-width='13' filter='url(%23e)'/></svg>");
    --glow-mask-still: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 393 852' preserveAspectRatio='none'><rect width='393' height='852' rx='48' fill='none' stroke='%23000' stroke-width='12'/></svg>");

    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: max(100%, calc(852 * var(--pt)));
    overflow: hidden;
    pointer-events: none;
    z-index: 6;
    -webkit-mask-image: var(--glow-mask);
    mask-image: var(--glow-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .glow-ring {
    /* A square larger than the screen's diagonal, centred, so any rotation still covers the
       edge. Positioned with margins so the transform stays free for GSAP's rotation. */
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(1000 * var(--pt));
    height: calc(1000 * var(--pt));
    margin: calc(-500 * var(--pt)) 0 0 calc(-500 * var(--pt));
    background: conic-gradient(
      from 210deg,
      var(--siri-1) 0deg,
      #b9ecc9 22deg,
      var(--siri-2) 70deg,
      #a7c9f0 112deg,
      var(--siri-3) 150deg,
      #e9b8d8 192deg,
      var(--siri-4) 236deg,
      #f3cf8a 280deg,
      var(--siri-1) 360deg
    );
  }

  /* The faint static border: no bloom, lower opacity. */
  .glow[data-glow-mode='still'] {
    -webkit-mask-image: var(--glow-mask-still);
    mask-image: var(--glow-mask-still);
    opacity: 0.6;
  }
  :global(html:not(.motion)) .glow[data-glow-mode='auto'] {
    -webkit-mask-image: var(--glow-mask-still);
    mask-image: var(--glow-mask-still);
    opacity: 0.6;
  }
</style>
