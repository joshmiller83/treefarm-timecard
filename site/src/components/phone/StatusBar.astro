---
/** STUB (device-a): replace the look, keep the Props and hooks in CONTRACT.md. */
export interface Props {
  time?: string;
  tone?: 'light' | 'dark';
  live?: boolean;
  signal?: 0 | 1 | 2 | 3 | 4;
  noService?: boolean;
  battery?: number;
}
const { time = '7:02', tone = 'light', live = true, signal = 4, noService = false, battery = 80 } = Astro.props;
---

<div class:list={['sb', `sb--${tone}`]} data-statusbar data-battery={battery}>
  <span class="sb-time" data-clock={live ? '' : 'fixed'}>{time}</span>
  <span class="sb-right">
    {
      noService ? (
        <span data-no-service>No Service</span>
      ) : (
        <span class="sb-bars">
          {[1, 2, 3, 4].map((i) => (
            <i data-bar={i} style={i <= signal ? '' : 'opacity:.3'} />
          ))}
        </span>
      )
    }
    <span data-wifi>wifi</span>
    <span>{battery}%</span>
  </span>
</div>

<style>
  .sb {
    position: absolute;
    inset: 0 0 auto;
    height: calc(54 * var(--pt));
    padding: calc(18 * var(--pt)) calc(32 * var(--pt)) 0 calc(48 * var(--pt));
    display: flex;
    justify-content: space-between;
    font-family: var(--font-system);
    font-weight: 600;
    font-size: calc(17 * var(--pt));
    color: #fff;
    z-index: 3;
  }
  .sb--dark {
    color: var(--ink);
  }
  .sb-right {
    display: flex;
    gap: calc(6 * var(--pt));
    font-size: calc(11 * var(--pt));
    align-items: center;
  }
  .sb-bars {
    display: flex;
    gap: calc(1.5 * var(--pt));
    align-items: flex-end;
  }
  .sb-bars i {
    width: calc(3 * var(--pt));
    height: calc(10 * var(--pt));
    background: currentColor;
    border-radius: 1px;
  }
</style>
