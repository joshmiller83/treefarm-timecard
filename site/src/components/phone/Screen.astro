---
/**
 * SCREEN: one state of a phone screen, as a layer in a section's [data-screens] container.
 *
 * Renders <div class="layer" data-state data-screen data-final?>. Without motion only the
 * [data-final] layer shows; with motion every layer stacks and scenes set opacity (shell.css).
 *
 * A non-final layer ships inside <template data-layer>: only the scene that animates it needs
 * it, so the static page never parses it and the first layout skips it. The motion core puts
 * a section's templates in place just before it builds the section's scene (motion.ts).
 *
 * Real captures: when public/screens/<stateId>.{avif,webp} exists (1179 × 2556, ≤ 200 KB;
 * capture.test.ts enforces both), the layer renders that image instead of the HTML
 * recreation in the slot, with the same alt. The folder comes from Astro's publicDir, so a
 * build run from any directory finds it. Hooks a scene needs on top of a capture (glows,
 * overlays) belong outside the Screen.
 */
import { publicDir } from 'astro:config/server';
import { CAPTURE_SIZE, captureDir, findCapture } from './capture.ts';

export interface Props {
  /** Stable id for this state; also the real-capture filename (see CONTRACT.md's registry). */
  stateId: string;
  /** Alt text for a real capture (the phone's aria-label usually says it all). */
  alt: string;
  /** Marks the layer shown without motion (exactly one per [data-screens]). */
  final?: boolean;
  /** 'dark' for lock screens, 'light' for app screens (background while loading a capture). */
  tone?: 'dark' | 'light';
  class?: string;
}

const { stateId, alt, final = false, tone = 'dark', class: cls } = Astro.props;
const capture = findCapture(stateId, captureDir(publicDir));
---

{
  final ? (
    <div class:list={['layer', `layer--${tone}`, cls]} data-state={stateId} data-screen={stateId} data-final data-capture={capture ? '' : undefined}>
      {capture ? (
        <img class="capture" src={capture} width={CAPTURE_SIZE.width} height={CAPTURE_SIZE.height} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <slot />
      )}
    </div>
  ) : (
    <template data-layer={stateId}>
      <div class:list={['layer', `layer--${tone}`, cls]} data-state={stateId} data-screen={stateId} data-capture={capture ? '' : undefined}>
        {capture ? (
          <img class="capture" src={capture} width={CAPTURE_SIZE.width} height={CAPTURE_SIZE.height} alt={alt} loading="lazy" decoding="async" />
        ) : (
          <slot />
        )}
      </div>
    </template>
  )
}

<style>
  .layer--dark {
    background: #000;
  }
  .layer--light {
    background: var(--surface);
  }
  .capture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
