---
/**
 * SCREEN: one state of a phone screen, as a layer in a section's [data-screens] container.
 *
 * Renders <div class="layer" data-state data-screen data-final?>. Without motion only the
 * [data-final] layer shows; with motion every layer stacks and scenes set opacity (shell.css).
 *
 * Real captures: when public/screens/<stateId>.{avif,webp,png} exists (1179 × 2556), the
 * layer renders that image instead of the HTML recreation in the slot, with the same alt.
 * Hooks a scene needs on top of a capture (glows, overlays) belong outside the Screen.
 */
import { CAPTURE_SIZE, findCapture } from './capture.ts';

export interface Props {
  /** Stable id for this state; also the real-capture filename (see CONTRACT.md's registry). */
  stateId: string;
  /** Alt text for a real capture (the phone's aria-label usually says it all). */
  alt: string;
  /** Marks the layer shown without motion (exactly one per [data-screens]). */
  final?: boolean;
  /** 'dark' for lock screens, 'light' for app screens (background while loading a capture). */
  tone?: 'dark' | 'light';
  class?: string;
}

const { stateId, alt, final = false, tone = 'dark', class: cls } = Astro.props;
const capture = findCapture(stateId);
---

<div
  class:list={['layer', `layer--${tone}`, cls]}
  data-state={stateId}
  data-screen={stateId}
  data-final={final ? '' : undefined}
  data-capture={capture ? '' : undefined}
>
  {
    capture ? (
      <img
        class="capture"
        src={capture}
        width={CAPTURE_SIZE.width}
        height={CAPTURE_SIZE.height}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <slot />
    )
  }
</div>

<style>
  .layer--dark {
    background: #000;
  }
  .layer--light {
    background: var(--surface);
  }
  .capture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
