{
  "name": "treefarm-timecard-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "The landing page for Tree Farm Time Card (treefarm.joshnliz.com).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "budgets": "node scripts/budgets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run build && npm run test:e2e",
    "shoot": "node scripts/shoot.ts",
    "og": "node scripts/og.ts",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "astro": "7.4.0",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "upng-js": "2.1.0",
    "vitest": "5.0.5"
  }
}
