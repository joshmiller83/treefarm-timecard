# Deploy settings. Copy to deploy/config.env (git-ignored) and adjust for your Mac.
# Every script in deploy/ reads this file.

# The macOS account the server runs as. It owns the data folder.
SERVICE_USER=jm

# launchd labels: <prefix>.timecard, <prefix>.timecard-backup, <prefix>.timecard-watchdog
LABEL_PREFIX=com.example

# Where the server keeps its binary, database, backups and logs.
DATA_DIR=/Users/jm/TreeFarmServer

# The server only listens on this Mac. Cloudflare Tunnel brings the public traffic in.
HOST=127.0.0.1
PORT=8790

# The public name the app talks to.
PUBLIC_HOSTNAME=timecard.example.com

# The server's executable product in Server/Package.swift.
SERVER_PRODUCT=Run

# Bcrypt cost for passwords. 12 is a good default on a 2017-era Intel Mac.
BCRYPT_COST=12

# Cloudflare Tunnel (only tunnel-add-hostname.sh uses these).
CLOUDFLARED_BIN=/usr/local/bin/cloudflared
# The tunnel's config.yml. This setup adds an ingress rule to an existing tunnel.
CF_CONFIG=/Users/jm/.cloudflared/config.yml
# Tunnel name or id.
CF_TUNNEL=my-tunnel
# launchd label of the daemon that runs cloudflared, so we can print its restart command.
CF_LABEL=com.example.cloudflared
