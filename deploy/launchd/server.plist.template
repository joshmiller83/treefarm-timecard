<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tree Farm Time Card server. System daemon: starts at boot, before anyone logs in,
     runs as __SERVICE_USER__ (not root), listens only on __HOST__:__PORT__, and is
     restarted by launchd whenever it exits (deploy/update.sh relies on that). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>UserName</key>
  <string>__SERVICE_USER__</string>
  <key>GroupName</key>
  <string>staff</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>serve</string>
    <string>--env</string>
    <string>production</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DATA_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TIMECARD_HOST</key>
    <string>__HOST__</string>
    <key>TIMECARD_PORT</key>
    <string>__PORT__</string>
    <key>TIMECARD_DB</key>
    <string>__DATA_DIR__/data/timecard.sqlite</string>
    <key>TIMECARD_BACKUP_DIR</key>
    <string>__DATA_DIR__/backups</string>
    <key>TIMECARD_BCRYPT_COST</key>
    <string>__BCRYPT_COST__</string>
    <key>LOG_LEVEL</key>
    <string>info</string>
    <key>HOME</key>
    <string>/Users/__SERVICE_USER__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__DATA_DIR__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/logs/server.log</string>
</dict>
</plist>
